name = "madlouh-pregnancy-care"
main = "dist/server/index.js"
compatibility_date = "2026-09-15"
compatibility_flags = ["nodejs_compat"]

[[d1_databases]]
binding = "DB"
database_name = "madlouh-pregnancy-db"
database_id = "REPLACE_WITH_YOUR_CLOUDFLARE_D1_DATABASE_ID"

# متغيرات غير سرية — يمكن أن تبقى هنا في wrangler.toml
[vars]
OTP_GATEWAY_URL = "https://madlouh.com.sa/otp-api/send.php"
ALLOWED_DOCTOR_EMAIL_DOMAIN = "madlouh.com.sa"

# أسرار — لا تُكتب هنا أبدًا؛ تُضبط عبر:
#   wrangler secret put SETUP_CODE
#   wrangler secret put SESSION_SECRET
#   wrangler secret put OTP_GATEWAY_API_KEY
